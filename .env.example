WEBHOOK_SECRET=replace-with-a-64-character-random-hex-secret
AGENT_MENTION=@my-agent
GITHUB_INSTALLATION_ID=12345678
ALLOWED_REPOSITORY_IDS=123456789
ALLOWED_REQUESTER_IDS=1234567
QUEUE_DB=state/jobs.sqlite3

# Worker only; keep real credentials out of version control.
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/github-app.pem
PI_MODEL=openai/replace-with-model-id
PI_PROVIDER_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
PI_WORKSPACES=state/workspaces
PI_RUNNER_IMAGE=github-agent-pi:1.5.2
PI_DOCKER_NETWORK=bridge
PI_TIMEOUT_SECONDS=900
